{
  "name": "node-red-switchbot",
  "version": "1.0.0",
  "description": "SwitchBot device control and status nodes for Node-RED",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/fetch-motion-sensor-pro.ts",
    "copy:html": "mkdir -p dist/nodes && cp src/nodes/*.html dist/nodes/",
    "build": "tsc && npm run copy:html",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "node-red",
    "switchbot",
    "smart-home",
    "iot",
    "home-automation",
    "motion-sensor",
    "presence-sensor",
    "temperature",
    "humidity",
    "co2",
    "curtain",
    "plug",
    "air-conditioner",
    "bot",
    "api"
  ],
  "author": "saladdays",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saladdays/-node-red-switchbot.git"
  },
  "bugs": {
    "url": "https://github.com/saladdays/-node-red-switchbot/issues"
  },
  "homepage": "https://github.com/saladdays/-node-red-switchbot#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/node-red": "^1.3.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "switchbot-credentials": "dist/nodes/switchbot-credentials.js",
      "switchbot-device-status": "dist/nodes/switchbot-device-status.js",
      "switchbot-device-command": "dist/nodes/switchbot-device-command.js"
    }
  }
}
